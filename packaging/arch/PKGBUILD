# Maintainer: Täpp Anders Sikvall <anders@sikvall.se>

pkgname=mde
pkgver=0.1.3
pkgrel=1
pkgdesc="Full-screen text-mode Markdown editor with native EPUB 2/3 exporter"
arch=('x86_64' 'aarch64' 'armv7h' 'i686')
url="https://github.com/sikvall/mde"
license=('MIT')
depends=('glibc' 'libzip' 'ncurses')
makedepends=('gcc' 'make')
optdepends=('pandoc: alternative export backend for HTML/XML/EPUB/LaTeX')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    ./configure --prefix=/usr --disable-werror
    make
}

check() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    make check
}

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    make DESTDIR="${pkgdir}" install
    install -Dm644 LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
}
